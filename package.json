{
  "name": "shadowbox-designer",
  "version": "1.0.0",
  "description": "Shadow box pattern designer (Electron desktop app)",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "potrace": "^2.1.8"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.shadowbox.designer",
    "productName": "Shadow Box Designer",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "renderer/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
